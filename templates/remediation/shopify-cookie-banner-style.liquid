{%- comment -%}
  Compact layout for the Shopify cookie banner (#shopify-pc__banner, injected by Shopify).
  Desktop: small card bottom-left, clear of the Zalo/call buttons on the right.
  Mobile: bottom sheet, title hidden, Accept/Decline/Preferences in one row, Accept and Decline equal weight.
  !important is needed because Shopify injects its own <style> after the theme CSS.
{%- endcomment -%}
<style>
  #shopify-pc__banner {
    left: 20px !important;
    right: auto !important;
    bottom: 20px !important;
    width: 440px !important;
    max-width: calc(100% - 40px) !important;
    min-width: 0 !important;
    margin: 0 !important; /* main.css gives every <section> a 15px margin, which lifted the banner */
    padding: 16px 18px !important;
    border-radius: 8px !important;
    font-size: 13.5px !important;
  }
  #shopify-pc__banner h2 { font-size: 15px !important; margin: 0 0 6px !important; }
  #shopify-pc__banner p { line-height: 1.45 !important; }
  #shopify-pc__banner .shopify-pc__banner__body { margin-bottom: 0 !important; }
  #shopify-pc__banner .shopify-pc__banner__btns {
    flex-direction: row !important;
    flex-wrap: wrap !important;
    justify-content: flex-start !important;
    gap: 0 8px !important;
  }
  #shopify-pc__banner .shopify-pc__banner__btns button {
    flex: 1 1 0 !important;
    margin: 10px 0 0 !important;
    padding: 7px 12px !important;
    font-size: 13.5px !important;
  }
  #shopify-pc__banner .shopify-pc__banner__btns button.shopify-pc__banner__btn-accept { order: 1 !important; }
  #shopify-pc__banner .shopify-pc__banner__btns button.shopify-pc__banner__btn-decline { order: 2 !important; }
  #shopify-pc__banner .shopify-pc__banner__btns button.shopify-pc__banner__btn-manage-prefs {
    order: 3 !important;
    flex-basis: 100% !important;
    margin-top: 4px !important;
    padding: 4px !important;
  }
  @media only screen and (max-width: 480px) {
    #shopify-pc__banner {
      left: 0 !important;
      bottom: 0 !important;
      width: 100% !important;
      max-width: 100% !important;
      max-height: 60% !important;
      border-radius: 10px 10px 0 0 !important;
      padding: 10px 12px 8px !important;
      font-size: 12px !important;
    }
    #shopify-pc__banner h2 { display: none !important; }
    #shopify-pc__banner p { line-height: 1.35 !important; }
    #shopify-pc__banner .shopify-pc__banner__btns { flex-wrap: nowrap !important; gap: 0 6px !important; }
    #shopify-pc__banner .shopify-pc__banner__btns button,
    #shopify-pc__banner .shopify-pc__banner__btns button.shopify-pc__banner__btn-manage-prefs {
      flex: 1 1 0 !important;
      margin: 8px 0 0 !important;
      padding: 6px 2px !important;
      font-size: 12.5px !important;
    }
  }
</style>
